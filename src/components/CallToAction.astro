---
import type { BlogLang } from '../data/i18n';

interface Props {
  lang: BlogLang;
}

const { lang } = Astro.props;

// `home` linkuje do strony produktu. Do 2026-08-14 nie robi\u0142 tego \u017BADEN wpis w
// serwisie \u2014 95 artyku\u0142\u00F3w ko\u0144czy\u0142o si\u0119 dwoma odno\u015Bnikami do sklep\u00F3w, a jedyne
// linki do /{lang}/ sz\u0142y z logo i nawigacji, czyli z blok\u00F3w powtarzalnych, kt\u00F3re
// Google dyskontuje. Na zapytanie \u201Evolcast" indeks bloga sta\u0142 wy\u017Cej ni\u017C produkt.
// To jest jedna zmiana w szablonie, kt\u00F3ra daje link ze wszystkich 165 stron.
const text: Record<BlogLang, { heading: string; body: string; cta: string; home: string }> = {
  en: {
    heading: 'Try Volcast',
    body: 'Get accurate solar production forecasts powered by physics. No inverter login required.',
    cta: 'Download Free',
    home: 'How Volcast forecasts your production',
  },
  pl: {
    heading: 'Wypr\u00F3buj Volcast',
    body: 'Dok\u0142adne prognozy produkcji solarnej oparte na fizyce. Bez logowania do falownika.',
    cta: 'Pobierz za darmo',
    home: 'Jak Volcast liczy prognoz\u0119 produkcji',
  },
  de: {
    heading: 'Volcast testen',
    body: 'Pr\u00E4zise, physikbasierte PV-Prognosen. Kein Wechselrichter-Login n\u00F6tig.',
    cta: 'Kostenlos laden',
    home: 'Wie Volcast deine Erzeugung prognostiziert',
  },
  it: {
    heading: 'Prova Volcast',
    body: "Previsioni di produzione fotovoltaica precise, basate sulla fisica. Senza accesso all'inverter.",
    cta: 'Scarica gratis',
    home: 'Come Volcast prevede la tua produzione',
  },
  fr: {
    heading: 'Essayez Volcast',
    body: "Des pr\u00E9visions de production photovolta\u00EFque pr\u00E9cises, fond\u00E9es sur la physique. Sans connexion \u00E0 l'onduleur.",
    cta: 'T\u00E9l\u00E9charger gratuitement',
    home: 'Comment Volcast pr\u00E9voit votre production',
  },
  ro: {
    heading: '\u00CEncearc\u0103 Volcast',
    body: 'Prognoze precise de produc\u021Bie fotovoltaic\u0103, bazate pe fizic\u0103. F\u0103r\u0103 acces la invertor.',
    cta: 'Descarc\u0103 gratuit',
    home: 'Cum prognozeaz\u0103 Volcast produc\u021Bia ta',
  },
};

const t = text[lang] ?? text.en;
---

<aside class="cta-section">
  <div class="cta-inner">
    <h3>{t.heading}</h3>
    <p>{t.body}</p>
    <div class="cta-buttons">
      <a href="https://play.google.com/store/apps/details?id=com.volcast.app" class="cta-button" target="_blank" rel="noopener" data-umami-event="app_store_click" data-umami-event-store="google_play" data-umami-event-location="blog_cta">
        Google Play
      </a>
      <a href="https://apps.apple.com/app/volcast-solar-forecast/id6758962799" class="cta-button secondary" target="_blank" rel="noopener" data-umami-event="app_store_click" data-umami-event-store="apple" data-umami-event-location="blog_cta">
        App Store
      </a>
    </div>
    <a href={`/${lang}/`} class="cta-home" data-umami-event="home_link_click" data-umami-event-location="blog_cta">
      {t.home} →
    </a>
  </div>
</aside>

<style>
  .cta-section {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--primary-glow);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .cta-inner { max-width: 480px; margin: 0 auto; }
  h3 {
    font-family: 'Syne', sans-serif;
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    font-size: 15px;
  }
  .cta-buttons { display: flex; gap: 0.75rem; justify-content: center; }
  .cta-button {
    display: inline-block;
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    background: var(--primary);
    color: var(--canvas);
    transition: opacity 0.2s ease;
  }
  .cta-button:hover { opacity: 0.9; color: var(--canvas); }
  .cta-button.secondary {
    background: transparent;
    border: 1px solid var(--primary);
    color: var(--primary);
  }
  .cta-button.secondary:hover { background: var(--primary-glow); }
  .cta-home {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: 14px;
    border-bottom: 1px solid transparent;
  }
  .cta-home:hover {
    color: var(--primary);
    border-bottom-color: var(--primary-dim);
    opacity: 1;
  }
</style>
