---
import { LANGS, LANG_LABEL, type BlogLang } from '../data/i18n';

interface Props {
  lang: BlogLang;
  alternates?: { lang: string; url: string }[];
}

const { lang, alternates = [] } = Astro.props;

// Dla każdego języka: aktywny (bieżący) lub link do wersji językowej tej treści
// (z alternatów), a gdy brak — do listingu bloga w tym języku.
const altByLang = new Map(alternates.map((a) => [a.lang, a.url]));
const items = LANGS.map((l) => ({
  lang: l,
  label: LANG_LABEL[l],
  active: l === lang,
  href: l === lang ? undefined : altByLang.get(l) ?? `/blog/${l}/`,
}));
---

<nav class="lang-switcher" aria-label="Language">
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="separator">|</span>}
      <span class={item.active ? 'active' : ''}>
        {item.active ? item.label : <a href={item.href}>{item.label}</a>}
      </span>
    </>
  ))}
</nav>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 14px;
    font-weight: 500;
  }
  .separator { color: var(--text-muted); }
  .active { color: var(--primary); font-weight: 600; }
  a { color: var(--text-muted); }
  a:hover { color: var(--text-primary); }
</style>
