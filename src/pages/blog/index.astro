---
export const prerender = false;

const acceptLang = Astro.request.headers.get('accept-language') || '';
const prefs = acceptLang.toLowerCase().split(',').map(l => l.trim());
const lang = prefs.some(l => l.startsWith('pl'))
  ? 'pl'
  : prefs.some(l => l.startsWith('de'))
    ? 'de'
    : 'en';

return Astro.redirect(`/blog/${lang}/`, 302);
---
