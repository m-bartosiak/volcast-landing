---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesNav from '../components/SeriesNav.astro';
import CallToAction from '../components/CallToAction.astro';
import { getCollection } from 'astro:content';
import { getClusterSlugs } from '../data/translations';
import { CLUSTER_LINKS } from '../data/clusters';
import { LANGS, t, type BlogLang } from '../data/i18n';

interface Props {
  post: any;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { data } = post;
const lang = data.lang as BlogLang;

// Parowanie tłumaczeń: slugi są przetłumaczone per język, więc parujemy po
// mapie topiców (src/data/translations.ts), awaryjnie po identycznym slugu.
// Buduje alternaty hreflang dla WSZYSTKICH innych języków w klastrze.
const slug = post.id.split('/').pop()!;
const allPosts = await getCollection('blog', ({ data: d }) => !d.draft);

// 1) po translationKey (wpisy z paczki), 2) po mapie topiców (istniejące wpisy), 3) po identycznym slugu.
let candidates = data.translationKey
  ? allPosts
      .filter(p => p.data.lang !== lang && p.data.translationKey === data.translationKey)
      .map(p => ({ lang: p.data.lang as typeof lang, slug: p.id.split('/').pop()! }))
  : [];
if (candidates.length === 0) candidates = getClusterSlugs(lang, slug);
if (candidates.length === 0) {
  candidates = LANGS
    .filter(l => l !== lang && allPosts.some(p => p.data.lang === l && p.id.split('/').pop() === slug))
    .map(l => ({ lang: l, slug }));
}
// Emituj alternat tylko gdy docelowy wpis realnie istnieje i nie jest draftem.
const alternates = candidates
  .filter(c => allPosts.some(p => p.data.lang === c.lang && p.id.split('/').pop() === c.slug))
  .map(c => ({ lang: c.lang, url: `/blog/${c.lang}/${c.slug}/` }));

// Powiązane posty: frontmatter relatedPosts + relacje klastra (po translationKey,
// rozwiązane do slugów w tym samym języku — patrz src/data/clusters.ts).
const relatedSlugs = new Set<string>(data.relatedPosts ?? []);
if (data.translationKey && CLUSTER_LINKS[data.translationKey]) {
  const relatedKeys = new Set(CLUSTER_LINKS[data.translationKey]);
  for (const p of allPosts) {
    if (p.data.lang === lang && p.data.translationKey && relatedKeys.has(p.data.translationKey)) {
      relatedSlugs.add(p.id.split('/').pop()!);
    }
  }
}
relatedSlugs.delete(slug);
const relatedPostsData = allPosts
  .filter(p => p.data.lang === lang && relatedSlugs.has(p.id.split('/').pop()!))
  .map(p => ({ title: p.data.title, slug: p.id.split('/').pop()!, lang: p.data.lang }));

// Częste pytania: Q&A wskazujące na ten post przez pole `guide` (hub → Q&A).
const allQA = await getCollection('qa', ({ data: d }) => !d.draft);
const relatedQuestions = allQA
  .filter(q => q.data.lang === lang && q.data.guide === slug)
  .map(q => ({ title: q.data.title, slug: q.id.split('/').pop()! }));

// JSON-LD BlogPosting
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.date.toISOString(),
  ...(data.updated && { dateModified: data.updated.toISOString() }),
  author: { '@type': 'Person', name: data.author },
  publisher: { '@type': 'Organization', name: 'Volter Labs' },
  inLanguage: lang,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${lang}/${slug}/`, Astro.site).href,
  },
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  lang={lang}
  canonicalUrl={new URL(`/blog/${lang}/${slug}/`, Astro.site).href}
  ogImage={data.ogImage}
  ogTitle={data.seo?.ogTitle}
  ogDescription={data.seo?.ogDescription}
  keywords={data.seo?.keywords}
  alternates={alternates}
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header lang={lang} alternates={alternates} />

  <div class="post-layout">
    <article class="post-article" data-pagefind-body data-pagefind-meta={`lang:${lang}`}>
      <header class="post-header">
        <h1>{data.title}</h1>
        <PostMeta
          date={data.date}
          updated={data.updated}
          tags={data.tags}
          lang={lang}
          content={post.body || ''}
          series={data.series}
        />
      </header>

      <div class="prose">
        <slot />
      </div>

      {data.series && data.seriesOrder !== undefined && (
        <SeriesNav series={data.series} seriesOrder={data.seriesOrder} lang={lang} />
      )}

      {relatedQuestions.length > 0 && (
        <aside class="common-questions">
          <h3>{t(lang).commonQuestions}</h3>
          <ul>
            {relatedQuestions.map(q => (
              <li><a href={`/blog/${lang}/q/${q.slug}/`}>{q.title}</a></li>
            ))}
          </ul>
        </aside>
      )}

      {relatedPostsData.length > 0 && (
        <aside class="related-posts">
          <h3>{t(lang).relatedPosts}</h3>
          <ul>
            {relatedPostsData.map(rp => (
              <li><a href={`/blog/${rp.lang}/${rp.slug}/`}>{rp.title}</a></li>
            ))}
          </ul>
        </aside>
      )}

      <CallToAction lang={lang} />
    </article>

    <aside class="toc-sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <Footer lang={lang} />
</BaseLayout>

<script>
  // Code block copy buttons
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
    const button = document.createElement('button');
    button.className = 'copy-button';
    button.textContent = 'Copy';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent || pre.textContent || '';
      await navigator.clipboard.writeText(code);
      button.textContent = 'Copied!';
      button.classList.add('copied');
      setTimeout(() => {
        button.textContent = 'Copy';
        button.classList.remove('copied');
      }, 2000);
    });
    pre.style.position = 'relative';
    pre.appendChild(button);
  });
</script>

<style>
  .post-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 3rem;
    align-items: start;
  }

  .post-article {
    background: var(--article-bg);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
  }

  .post-header {
    margin-bottom: 2rem;
    position: relative;
    background-image: radial-gradient(ellipse at 20% 0%, rgba(0, 255, 157, 0.05) 0%, transparent 60%);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding-top: 0.5rem;
  }

  .post-header h1 {
    font-family: 'Syne', sans-serif;
    font-size: 36px;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  .toc-sidebar {
    display: block;
    align-self: stretch;
  }

  .related-posts {
    border-top: 1px solid var(--divider);
    padding-top: 2rem;
    margin-top: 3rem;
  }

  .related-posts h3 {
    font-size: 18px;
    margin-bottom: 0.75rem;
  }

  .related-posts ul {
    list-style: none;
    padding: 0;
  }

  .related-posts li {
    margin-bottom: 0.5rem;
  }

  .related-posts a {
    color: var(--link-prose);
    font-size: 15px;
  }

  .related-posts a:hover {
    color: var(--link-hover);
  }

  .common-questions {
    border-top: 1px solid var(--divider);
    padding-top: 2rem;
    margin-top: 3rem;
  }
  .common-questions h3 { font-size: 18px; margin-bottom: 0.75rem; }
  .common-questions ul { list-style: none; padding: 0; }
  .common-questions li { margin-bottom: 0.5rem; }
  .common-questions a { color: var(--link-prose); font-size: 15px; }
  .common-questions a:hover { color: var(--link-hover); }

  @media (max-width: 1024px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
    .toc-sidebar { display: none; }
    .post-article { padding: 1.5rem; }
    .post-header h1 { font-size: 28px; }
  }
</style>
